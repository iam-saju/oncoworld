{
  "n_concurrent_trials": 4,
  "agent_setup_timeout_multiplier": 3.0,
  "agents": [
    {
      "name": "claude-code",
      "model_name": "anthropic/claude-haiku-5-5",
      "kwargs": {
        "disable_web_search": true,
        "reasoning_effort": "high",
        "max_budget_usd": "1"
      },
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "ANTHROPIC_CUSTOM_HEADERS": "${ANTHROPIC_CUSTOM_HEADERS}"
      }
    },
    {
      "name": "opencode",
      "model_name": "opencode/deepseek-v4.1-flash-free",
      "kwargs": {
        "disable_web_search": true
      },
      "env": {
        "OPENCODE_API_KEY": "${OPENCODE_API_KEY}"
      }
    }
  ],
  "tasks": [
    { "path": "harbor_cases/dlbcl_0001_bulky_stage_iii_hbv_v2_fhir" },
    { "path": "harbor_cases/dlbcl_0002_splenic_stage_iii_cardiac_v2_fhir" },
    { "path": "harbor_cases/dlbcl_0003_renal_adrenal_cns_high_v2_fhir" },
    { "path": "harbor_cases/dlbcl_0004_double_hit_addendum_v2_fhir" },
    { "path": "harbor_cases/dlbcl_0005_limited_stage_flyer_v2_fhir" },
    { "path": "harbor_cases/intracranial_mesenchymal_0001_narrative" }
  ]
}
