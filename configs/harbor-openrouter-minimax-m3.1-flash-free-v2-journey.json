                  "temperature": true,
                  "tool_call": true,
                  "limit": {
                    "context": 200000,
                    "output": 8192
                  },
                  "modalities": {
                    "input": [
                      "text"
                    ],
                    "output": [
                      "text"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "tasks": [
    {
      "path": "harbor_cases/dlbcl_0003_journey_v2"
    }
  ]
}
